mandate fetch_data {
  intent: "Fetch and clean raw data"

  input: { source: string }
  output: { data: string, rows: int }

  flow {
    data = synthesize {
      given: input.source
      produce: string
      instruction: "Generate sample CSV data for this source"
    }
    rows = 100
    return { data: data, rows: rows }
  }

  verify {
    output.rows > 0
    output.data.length > 0
  }
}

mandate analyze_data {
  intent: "Analyze cleaned data and produce insights"

  input: { data: string, question: string }
  output: { answer: string, confidence: float }

  flow {
    answer = synthesize {
      given: input.data, input.question
      produce: string
      instruction: "Answer the question based on the provided data"
    }
    confidence = 0.75
    return { answer: answer, confidence: confidence }
  }

  verify {
    output.confidence in 0.0..1.0
    output.answer.length > 0
  }
}
